# คัดลอกไฟล์นี้เป็น .env ก่อนใช้งาน:  cp .env.example .env
# ห้าม commit ไฟล์ .env (มีรหัสผ่าน) — .gitignore กันไว้ให้แล้ว

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=equipment_db

# ---------- การเชื่อมต่อฐานข้อมูลของแอป ----------
# ใช้ใน container (host = db ซึ่งคือชื่อ service ใน docker-compose.yml)
# ถ้ารัน `npm run dev` หรือ `npm run test:integration` นอก container
# ให้เปลี่ยน host จาก db เป็น localhost:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/equipment_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@db:5432/equipment_db?schema=public

# ---------- แอป ----------
# port บนเครื่อง host ที่ใช้เปิดแอป (http://localhost:3000)
APP_PORT=3000
# ชื่อ image ของแอป — บน VPS เปลี่ยนเป็น image จาก GHCR เช่น ghcr.io/<user>/<repo>:latest
APP_IMAGE=equipment-app:local
# ชื่อ image ของ service migrate (Prisma CLI + migration + seed)
MIGRATOR_IMAGE=equipment-migrator:local
# เวอร์ชันที่แสดงที่ footer — ถูกฝังตอน build (ต้อง build ใหม่ถ้าเปลี่ยนค่า)
NEXT_PUBLIC_APP_VERSION=dev
